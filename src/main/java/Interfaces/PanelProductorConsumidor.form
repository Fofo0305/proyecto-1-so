<Component class="javax.swing.JLabel" name="introduccion"><Properties><Property name="text" type="java.lang.String" value="&lt;html&gt;&lt;h2&gt;Productor y consumidor local&lt;/h2&gt;Crea primero el buffer en el computador que ejecutara el proceso.&lt;/html&gt;" /></Properties><Constraints><Constraint layoutClass="org.netbeans.modules.form.compat2.layouts.DesignBorderLayout" value="org.netbeans.modules.form.compat2.layouts.DesignBorderLayout$BorderConstraintsDescription"><BorderConstraints direction="North" /></Constraint></Constraints></Component>
